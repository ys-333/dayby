#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generated code — regenerate with:
#   dart run build_runner build --delete-conflicting-outputs
*.g.dart
*.freezed.dart

# Personal Claude Code overrides
.claude/settings.local.json

# Git worktrees live here when two agents share this checkout. Each is a full
# second working tree: untracked, and large enough that one `git add -A` in
# the main checkout would commit an entire copy of the repo.
.claude/worktrees/
