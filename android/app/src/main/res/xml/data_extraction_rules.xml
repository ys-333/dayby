<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) replacement for backup_rules.xml.

  cloud-backup covers Google's automatic backup; device-transfer covers
  phone-to-phone migration. Both include the database for the same reason: it
  is the only copy of the user's history.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="riyaz.sqlite" />
        <exclude domain="file" path="riyaz.sqlite-journal" />
        <exclude domain="file" path="riyaz.sqlite-wal" />
        <exclude domain="file" path="riyaz.sqlite-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="riyaz.sqlite" />
        <exclude domain="file" path="riyaz.sqlite-journal" />
        <exclude domain="file" path="riyaz.sqlite-wal" />
        <exclude domain="file" path="riyaz.sqlite-shm" />
    </device-transfer>
</data-extraction-rules>
